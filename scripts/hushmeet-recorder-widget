#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_ROOT="${HUSHNOTE_VENV:-$ROOT/venv}"
if [ ! -d "$VENV_ROOT" ] && [ -d "$ROOT/../../venv" ]; then
  VENV_ROOT="$(cd "$ROOT/../../venv" && pwd)"
fi
export HUSHNOTE_VENV="$VENV_ROOT"
exec /usr/bin/python3 "$ROOT/scripts/hushmeet-recorder-widget.py" "$@"
